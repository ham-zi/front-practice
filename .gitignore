# --- OS 전용 파일 ---
.DS_Store
Thumbs.db

# --- IDE(에디터) 관련 ---
.vscode/
.idea/
*.swp

# --- Node.js / React (front 폴더 내) ---
# 모든 하위 폴더의 node_modules를 제외합니다.
**/node_modules/
**/dist/
**/build/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- DevOps / 백엔드 관련 ---
# 파이썬 가상환경이나 자바 빌드 파일 등 (혹시 몰라 추가)
**/__pycache__/
**/.venv/
**/target/
**/.gradle/
*.class

# --- 로그 및 임시 파일 ---
*.log
tmp/
/.metadata/
