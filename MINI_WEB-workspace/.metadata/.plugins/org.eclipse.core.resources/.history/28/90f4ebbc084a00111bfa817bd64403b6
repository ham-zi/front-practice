<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  <mapper namespace="memberMapper">
  	
  	<insert id="insertMember" parameterType="member">
  		INSERT
  		  INTO
  		       MARKET_MEMBER
  		       (
  		       USER_NO
  		     , USER_ID
  		     , USER_PWD
  		     , USER_NAME
  		     , ADDRESS
  		     , PHONE_NUMBER
  		     , EMAIL
  		       )
  	    VALUES
  	           (
  	           SEQ_USER_NO.NEXTVAL
  	         , #{userId}
  	         , #{userPwd}
  	         , #{userName}
  	         , #{address}
  	         , #{phoneNumber}
  	         , #{email}
  	           )
  	</insert>
  	
  	<select id="login" resultType="member" parameterType="member">
  		SELECT
  		       USER_NO userNo
  		     , USER_ID userId
  		     , USER_NAME userName
  		     , ADDRESS
  		     , PHONE_NUMBER phoneNumber
  		     , EMAIL 
  		     , ENROLL_DATE enrollDate
  		     , MODIFY_DATE modifyDate
  		     , STATUS
  		  FROM
  		       WEB_MEMBER
  		 WHERE
  		       USER_ID = #{userId}
  		   AND
  		       USER_PWD = #{userPwd}
  		   AND
  		       STATUS = 'N'
  	</select>
  
  </mapper>